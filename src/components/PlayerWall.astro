---
// Parete curva: fila orizzontale di giocatori su una curva 3D. Le schede ai
// bordi si inclinano verso l'interno, quella al centro e' dritta e a fuoco.
// Scorrimento col dito su telefono, con le frecce su desktop.
// Sceglie la variante C provata in /demo-caroselli.
import type { CollectionEntry } from "astro:content";

interface Props {
  players: CollectionEntry<"giocatori">[];
}
const { players } = Astro.props;
---
<section class="wall-section" aria-labelledby="wall-title">
  <div class="wall-head">
    <h2 id="wall-title" class="font-display">La rosa</h2>
    <div class="wall-nav" aria-hidden="true">
      <button type="button" data-wall-prev aria-label="Scorri verso sinistra">‹</button>
      <button type="button" data-wall-next aria-label="Scorri verso destra">›</button>
    </div>
  </div>

  <ul class="wall" data-wall>
    {players.map((g) => (
      <li class="wall-card">
        <button
          type="button"
          class="wall-btn"
          data-player
          data-nome={g.data.nome}
          data-ruolo={g.data.ruolo}
          data-numero={g.data.numero ?? ""}
          data-foto={g.data.foto ?? ""}
          aria-label={`Apri la scheda di ${g.data.nome}`}
        >
        <img src={g.data.foto || "/img/silhouette.svg"} alt={g.data.foto ? `Ritratto di ${g.data.nome}` : `Segnaposto: foto non disponibile per ${g.data.nome}`} loading="lazy" />
        <div class="card-info">
          {g.data.numero != null && <span class="num font-display" aria-hidden="true">{g.data.numero}</span>}
          <p class="nome font-display">{g.data.nome}</p>
          <p class="ruolo">{g.data.ruolo ?? "Ruolo da definire"}{g.data.numero != null && <span class="sr-only"> numero {g.data.numero}</span>}</p>
        </div>
        </button>
      </li>
    ))}
  </ul>
</section>

<style>
  .wall-section {
    padding: clamp(2.5rem, 6vw, 4rem) 0 clamp(2rem, 5vw, 3rem);
  }
  .wall-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    max-width: 1200px;
    margin: 0 auto 1.5rem;
    padding: 0 clamp(1rem, 4vw, 2.5rem);
  }
  .wall-head h2 {
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    margin: 0;
  }
  /* Le frecce servono solo dove c'e' un puntatore: col dito si scorre e basta. */
  .wall-nav { display: none; gap: 0.5rem; }
  @media (pointer: fine) {
    .wall-nav { display: flex; }
  }
  .wall-nav button {
    background: transparent;
    color: var(--giallo);
    border: 1px solid var(--oro);
    font-size: 1.4rem;
    line-height: 1;
    width: 2.75rem;
    height: 2.75rem;
    cursor: pointer;
    transition: background-color 0.2s var(--ease-out-quart), color 0.2s var(--ease-out-quart);
  }
  .wall-nav button:hover,
  .wall-nav button:focus-visible {
    background: var(--giallo);
    color: var(--bg);
  }
  .wall-nav button[disabled] {
    opacity: 0.35;
    cursor: default;
  }

  .wall {
    display: flex;
    gap: clamp(0.85rem, 2vw, 1.25rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    perspective: 900px;
    /* Il padding laterale porta la prima e l'ultima scheda al centro. */
    padding: 1.5rem max(1rem, calc(50% - 100px));
    margin: 0;
    list-style: none;
    scrollbar-width: none;
  }
  .wall::-webkit-scrollbar { display: none; }

  .wall-card {
    flex: 0 0 200px;
    scroll-snap-align: center;
    background: var(--surface);
    border: 1px solid color-mix(in oklch, var(--oro) 45%, transparent);
    overflow: hidden;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .wall-btn {
    display: block;
    width: 100%;
    border: none;
    padding: 0;
    margin: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .wall-card img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    background: color-mix(in oklch, var(--bg) 70%, var(--surface));
  }
  .card-info {
    padding: 0.7rem 0.85rem 0.9rem;
    position: relative;
  }
  .num {
    position: absolute;
    top: -2rem;
    right: 0.6rem;
    font-size: 2.5rem;
    line-height: 1;
    color: var(--giallo);
    text-shadow: 0 2px 12px color-mix(in oklch, var(--bg) 85%, transparent);
  }
  .nome { font-size: 1rem; margin: 0; }
  .ruolo { font-size: 0.8rem; color: var(--oro); margin: 0.15rem 0 0; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Senza JS o con moto ridotto resta una fila piana, perfettamente usabile. */
  @media (prefers-reduced-motion: reduce) {
    .wall-card { transform: none !important; filter: none !important; }
  }
</style>

<script>
  const wall = document.querySelector<HTMLElement>("[data-wall]");
  const prev = document.querySelector<HTMLButtonElement>("[data-wall-prev]");
  const next = document.querySelector<HTMLButtonElement>("[data-wall-next]");

  if (wall) {
    const cards = [...wall.querySelectorAll<HTMLElement>(".wall-card")];
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Curvatura: piu' una scheda si allontana dal centro, piu' ruota verso
    // l'interno, arretra e si scurisce.
    let raf = 0;
    const disegna = () => {
      const box = wall.getBoundingClientRect();
      const centro = box.left + box.width / 2;
      for (const c of cards) {
        const r = c.getBoundingClientRect();
        const d = (r.left + r.width / 2 - centro) / (box.width / 2);
        const k = Math.max(-1.4, Math.min(1.4, d));
        c.style.transform =
          `rotateY(${-k * 34}deg) translateZ(${-Math.abs(k) * 90}px) scale(${1 - Math.abs(k) * 0.12})`;
        c.style.filter = `brightness(${1 - Math.abs(k) * 0.45})`;
      }
      raf = 0;
    };
    const pianifica = () => { if (!raf) raf = requestAnimationFrame(disegna); };

    if (!reduced) {
      wall.addEventListener("scroll", pianifica, { passive: true });
      addEventListener("resize", pianifica);
      pianifica();
    }

    // Frecce: scorrono di una scheda per volta e si spengono ai capi.
    const passo = () => {
      const c = cards[0];
      const gap = parseFloat(getComputedStyle(wall).columnGap || "16");
      return c ? c.getBoundingClientRect().width + gap : 220;
    };
    const scorri = (dir: number) => wall.scrollBy({ left: dir * passo(), behavior: reduced ? "auto" : "smooth" });
    prev?.addEventListener("click", () => scorri(-1));
    next?.addEventListener("click", () => scorri(1));

    const aggiornaFrecce = () => {
      if (!prev || !next) return;
      const max = wall.scrollWidth - wall.clientWidth;
      prev.disabled = wall.scrollLeft <= 2;
      next.disabled = wall.scrollLeft >= max - 2;
    };
    wall.addEventListener("scroll", aggiornaFrecce, { passive: true });
    addEventListener("resize", aggiornaFrecce);
    aggiornaFrecce();
  }
</script>
