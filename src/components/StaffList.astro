---
// Elenco persone con foto tonda, nome e incarico: staff tecnico nella pagina
// Squadra, dirigenza nella pagina Club. Senza foto compare la silhouette.
import type { CollectionEntry } from "astro:content";

interface Props {
  persone: CollectionEntry<"staff">[];
}
const { persone } = Astro.props;
---
<ul class="staff-list">
  {persone.map((membro) => {
    const hasFoto = Boolean(membro.data.foto);
    const alt = hasFoto
      ? `Foto di ${membro.data.nome}`
      : `Segnaposto: foto non disponibile per ${membro.data.nome}`;
    return (
      <li>
        <img src={membro.data.foto || "/img/silhouette.svg"} alt={alt} loading="lazy" tabindex="0" data-staff-foto />
        <div>
          <p class="nome">{membro.data.nome}</p>
          <p class="incarico">{membro.data.incarico}</p>
        </div>
      </li>
    );
  })}
</ul>
<style>
  .staff-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
  }
  .staff-list li {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .staff-list img {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: top;
    flex-shrink: 0;
    border: 1px solid var(--oro);
    position: relative;
    /* ingrandita cresce verso destra: a sinistra c'e' il bordo dello schermo */
    transform-origin: left center;
    cursor: zoom-in;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform 0.35s var(--ease-out-quart),
      box-shadow 0.35s var(--ease-out-quart);
  }
  /* La foto si ingrandisce sopra il resto, come le colonne della rosa: col
     mouse al passaggio, sul telefono al tocco (classe "grande", vedi script;
     si richiude toccando di nuovo o altrove), da tastiera col focus. */
  .staff-list img.grande,
  .staff-list img:focus-visible {
    transform: scale(2.6);
    z-index: 2;
    border-color: var(--giallo);
    box-shadow: 0 10px 28px oklch(0 0 0 / 0.55);
    outline: none;
  }
  .staff-list img.grande { cursor: zoom-out; }
  @media (hover: hover) and (pointer: fine) {
    .staff-list img:hover {
      transform: scale(2.6);
      z-index: 2;
      border-color: var(--giallo);
      box-shadow: 0 10px 28px oklch(0 0 0 / 0.55);
    }
  }
  /* sul telefono un po' di piu': la foto piccola si vede appena */
  @media (max-width: 719px) {
    .staff-list img.grande { transform: scale(3.3); }
  }
  @media (prefers-reduced-motion: reduce) {
    .staff-list img { transition: none; }
  }
  .staff-list .nome {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1rem;
    margin: 0;
  }
  .staff-list .incarico {
    color: var(--oro);
    font-size: 0.85rem;
    margin: 0.2rem 0 0;
  }
</style>

<script>
  // Tocco sul telefono: apre la foto toccata e chiude le altre; un tocco su
  // quella aperta o altrove la richiude. Col mouse basta il passaggio.
  if (!matchMedia("(hover: hover) and (pointer: fine)").matches) {
    document.addEventListener("click", (e) => {
      const foto = (e.target as Element)?.closest<HTMLElement>("[data-staff-foto]");
      document.querySelectorAll<HTMLElement>("[data-staff-foto].grande").forEach((f) => {
        if (f !== foto) f.classList.remove("grande");
      });
      foto?.classList.toggle("grande");
    });
  }
</script>
