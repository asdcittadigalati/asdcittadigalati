---
import { getCollection } from "astro:content";

const livelloOrdine: Record<string, number> = { main: 0, tecnico: 1, partner: 2 };
const sponsors = (await getCollection("sponsor")).sort(
  (a, b) => livelloOrdine[a.data.livello] - livelloOrdine[b.data.livello]
);
---
{sponsors.length > 0 && (
  <section class="sponsor-strip" aria-labelledby="sponsor-title">
    <div class="inner">
      <h2 id="sponsor-title" class="font-display">I nostri sponsor</h2>
    </div>
    {/* Nastro scorrevole: la lista è duplicata (copia aria-hidden) per chiudere
        il giro senza vuoti. Si ferma su hover/focus e con reduced-motion. */}
    <div class="marquee" role="region" aria-label="Loghi degli sponsor">
      <div class="blur-edge left" aria-hidden="true"></div>
      <div class="blur-edge right" aria-hidden="true"></div>
      <div class="marquee-track">
        <ul class="logos">
          {sponsors.map((sponsor) => (
            <li class:list={["logo-item", sponsor.data.livello]} data-nome={sponsor.data.nome}>
              {sponsor.data.url ? (
                <a href={sponsor.data.url} target="_blank" rel="noopener noreferrer" class="logo-link">
                  <img src={sponsor.data.logo} alt={`Logo ${sponsor.data.nome}`} class="logo-img" loading="lazy" />
                </a>
              ) : (
                <img src={sponsor.data.logo} alt={`Logo ${sponsor.data.nome}`} class="logo-img" loading="lazy" />
              )}
            </li>
          ))}
        </ul>
        <ul class="logos" aria-hidden="true">
          {sponsors.map((sponsor) => (
            <li class:list={["logo-item", sponsor.data.livello]} data-nome={sponsor.data.nome}>
              <img src={sponsor.data.logo} alt="" class="logo-img" loading="lazy" />
            </li>
          ))}
        </ul>
      </div>
    </div>
    {/* Anteprima grande al passaggio del mouse: i loghi reali sono striscioni
        con testo, nel nastro si riconoscono ma non si leggono. Elemento
        riempito e posizionato dallo script; solo puntatori fini. */}
    <div class="logo-anteprima" data-logo-anteprima aria-hidden="true">
      <img alt="" />
      <p class="font-body"></p>
    </div>
  </section>
)}
<style>
  .sponsor-strip {
    background: oklch(0.95 0.01 265);
    padding: clamp(2.5rem, 6vw, 4rem) 0;
    overflow: hidden;
  }
  .inner {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
    padding: 0 clamp(1rem, 4vw, 2.5rem);
  }
  .sponsor-strip h2 {
    color: var(--bg);
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    margin: 0 0 2rem;
  }
  .marquee {
    display: flex;
    overflow: hidden;
    position: relative;
  }
  /* Sfocatura progressiva ai due lati: i loghi si dissolvono invece di essere
     tagliati di netto. Due pannelli con backdrop-filter e una maschera che li
     fa svanire verso il centro. Dove backdrop-filter manca resta la sola
     sfumatura di colore: nessuna rottura. */
  .blur-edge {
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(56px, 12vw, 160px);
    z-index: 2;
    pointer-events: none;
    backdrop-filter: blur(6px);
  }
  .blur-edge.left {
    left: 0;
    mask-image: linear-gradient(to right, oklch(0 0 0), transparent);
    background: linear-gradient(to right, oklch(0.95 0.01 265), transparent);
  }
  .blur-edge.right {
    right: 0;
    mask-image: linear-gradient(to left, oklch(0 0 0), transparent);
    background: linear-gradient(to left, oklch(0.95 0.01 265), transparent);
  }
  .marquee-track {
    display: flex;
    flex-shrink: 0;
    animation: marquee-scroll 18s linear infinite;
  }
  /* Pausa solo dove l'hover e' reale: sul touch lo stato :hover (e il focus
     dei link tappati) resta appiccicato dopo il tocco e congelava il nastro. */
  @media (hover: hover) {
    .marquee:hover .marquee-track,
    .marquee:focus-within .marquee-track {
      animation-play-state: paused;
    }
  }
  /* Sul touch la pausa e' un toggle esplicito: tocca per fermare e leggere,
     ritocca per far ripartire (classe gestita dallo script). */
  .marquee.fermo .marquee-track {
    animation-play-state: paused;
  }
  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .logos {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
    list-style: none;
    margin: 0;
    padding: 0 clamp(1.25rem, 3vw, 2.5rem);
  }
  .logo-img {
    /* I loghi reali sono striscioni con testo (foto 1014x660), non marchi
       secchi: sotto i 4.5rem diventano francobolli illeggibili. */
    height: clamp(5.25rem, 8vw, 5.75rem);
    width: auto;
    border-radius: 4px;
    filter: grayscale(1);
    transition: filter 0.3s var(--ease-out-quart);
  }
  .logo-item.main .logo-img {
    height: clamp(6.5rem, 10vw, 7.5rem);
  }
  .logo-item.tecnico .logo-img {
    height: clamp(5.75rem, 9vw, 6.5rem);
  }
  .logo-item:hover .logo-img,
  .logo-item:focus-within .logo-img {
    filter: grayscale(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
    }
    .marquee-track > ul[aria-hidden] {
      display: none;
    }
    .blur-edge {
      display: none;
    }
    .logos {
      flex-wrap: wrap;
      justify-content: center;
    }
    .logo-img {
      transition: none;
    }
  }
</style>
<style>
  .logo-anteprima {
    position: fixed;
    z-index: 70;
    max-width: min(420px, 86vw);
    background: oklch(0.98 0.005 75);
    border: 1px solid var(--oro);
    box-shadow: 0 14px 40px oklch(0.15 0.04 265 / 0.35);
    padding: 0.5rem 0.5rem 0.35rem;
    pointer-events: none;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.18s var(--ease-out-quart), transform 0.18s var(--ease-out-quart);
  }
  .logo-anteprima.visibile {
    opacity: 1;
    transform: translateY(0);
  }
  .logo-anteprima img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 3px;
  }
  .logo-anteprima p {
    margin: 0.3rem 0 0;
    text-align: center;
    font-size: 0.8rem;
    color: oklch(0.3 0.04 265);
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-anteprima { transition: none; }
  }
</style>
<script>
  // Sul touch non esiste hover: il tocco sul nastro ferma la corsa per
  // leggere i loghi, un secondo tocco la fa ripartire. I tocchi sui link
  // restano navigazione e non togglano.
  const nastroTouch = document.querySelector<HTMLElement>(".marquee");
  if (nastroTouch && matchMedia("(hover: none)").matches) {
    nastroTouch.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) return;
      nastroTouch.classList.toggle("fermo");
    });
  }

  // Anteprima grande dei loghi: segue l'elemento su cui sta il mouse, sopra
  // il nastro (o sotto se non c'e' spazio). Solo con puntatore fine: sul
  // touch non esiste hover e il tocco deve restare il click del link.
  const scheda = document.querySelector<HTMLElement>("[data-logo-anteprima]");
  if (scheda && matchMedia("(pointer: fine)").matches) {
    const img = scheda.querySelector("img")!;
    const didascalia = scheda.querySelector("p")!;

    const mostra = (voce: HTMLElement) => {
      const logo = voce.querySelector<HTMLImageElement>(".logo-img");
      if (!logo) return;
      img.src = logo.src;
      didascalia.textContent = voce.dataset.nome ?? "";
      scheda.classList.add("visibile");
      const r = voce.getBoundingClientRect();
      // larghezza reale solo dopo il primo paint: misurata qui va bene lo stesso
      const w = scheda.offsetWidth || 360;
      const h = scheda.offsetHeight || 280;
      const x = Math.min(Math.max(r.left + r.width / 2 - w / 2, 8), innerWidth - w - 8);
      const sopra = r.top - h - 14;
      scheda.style.left = `${x}px`;
      scheda.style.top = `${sopra > 8 ? sopra : r.bottom + 14}px`;
    };

    const nastro = document.querySelector(".marquee");
    nastro?.addEventListener("mouseover", (e) => {
      const voce = (e.target as HTMLElement).closest<HTMLElement>(".logo-item");
      if (voce) mostra(voce);
    });
    nastro?.addEventListener("mouseleave", () => scheda.classList.remove("visibile"));
    // Tastiera: i loghi con link prendono il focus, stessa anteprima.
    nastro?.addEventListener("focusin", (e) => {
      const voce = (e.target as HTMLElement).closest<HTMLElement>(".logo-item");
      if (voce) mostra(voce);
    });
    nastro?.addEventListener("focusout", () => scheda.classList.remove("visibile"));
  }
</script>
