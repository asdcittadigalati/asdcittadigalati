---
// Tabellone della stagione, in stile display a segmenti da bordo campo.
// NON e' la fila di numeroni con etichetta sotto tipica dei siti aziendali:
// e' un pannello scuro unico con cifre monospaziate, cornice e spie.
//
// I numeri sono quelli del Citta' di Galati nella classifica di Tuttocampo:
// letti alla pubblicazione del sito e poi a ogni visita da /api/classifica
// (Worker), cosi' si aggiornano da soli dopo ogni giornata.
// Finche' la squadra non ha giocato (o Tuttocampo non risponde) il pannello
// resta spento e lo dichiara: meglio onesto che numeri inventati.
import { leggiClassifica, type RigaClassifica } from "../lib/classifica";
import { WIDGET_URLS, TEAM_ID } from "../lib/tuttocampo";

let noi: RigaClassifica | undefined;
try {
  const r = await fetch(WIDGET_URLS.classifica!, { signal: AbortSignal.timeout(5000) });
  if (r.ok) noi = leggiClassifica(await r.text()).find((s) => s.id === TEAM_ID);
} catch {
  // Rete assente durante la compilazione: ci pensa l'aggiornamento in pagina.
}
const iniziata = (noi?.g ?? 0) > 0;
const { v: vinte = 0, n: pareggiate = 0, p: perse = 0, gf: golFatti = 0 } = noi ?? {};

const voci = [
  { sigla: "V", label: "Vinte", valore: vinte },
  { sigla: "N", label: "Pareggiate", valore: pareggiate },
  { sigla: "P", label: "Perse", valore: perse },
  { sigla: "GF", label: "Gol fatti", valore: golFatti },
];
---
<section class="scoreboard-section" aria-labelledby="score-title">
  <div class="inner">
    <div class="panel" data-scoreboard data-noi={TEAM_ID}>
      <div class="panel-head">
        <span class="spia" aria-hidden="true"></span>
        <h2 id="score-title" class="font-display">Stagione 2026-27</h2>
        <span class="stato" data-stato>{iniziata ? "in corso" : "non iniziata"}</span>
      </div>

      <dl class="cifre">
        {voci.map((v) => (
          <div class="cifra">
            <dt>
              <abbr title={v.label}>{v.sigla}</abbr>
            </dt>
            <dd class="valore font-display" data-valore={v.valore}>{iniziata ? v.valore : "-"}</dd>
            <span class="etichetta">{v.label}</span>
          </div>
        ))}
      </dl>

      {!iniziata && (
        <p class="nota" data-nota>
          Il campionato non è ancora cominciato. I numeri si accendono da soli
          dopo la prima giornata.
        </p>
      )}
    </div>
  </div>
</section>

<style>
  .scoreboard-section {
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1rem, 4vw, 2.5rem);
  }
  .inner { max-width: 900px; margin: 0 auto; }

  .panel {
    background:
      repeating-linear-gradient(
        0deg,
        color-mix(in oklch, var(--bg) 92%, oklch(0 0 0)) 0 2px,
        color-mix(in oklch, var(--bg) 88%, oklch(0 0 0)) 2px 4px
      );
    border: 2px solid var(--oro);
    padding: clamp(1.1rem, 3vw, 1.75rem);
  }
  .panel-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    border-bottom: 1px solid color-mix(in oklch, var(--oro) 40%, transparent);
    padding-bottom: 0.7rem;
    margin-bottom: clamp(1rem, 3vw, 1.5rem);
  }
  .panel-head h2 {
    font-size: clamp(1.05rem, 2.4vw, 1.4rem);
    margin: 0;
    flex: 1;
  }
  .spia {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--rosso);
    box-shadow: 0 0 10px var(--rosso);
    animation: spia-lampeggia 2.4s ease-in-out infinite;
  }
  @keyframes spia-lampeggia {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 1; }
  }
  .stato {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--oro);
  }

  .cifre {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(0.5rem, 2vw, 1.25rem);
    margin: 0;
  }
  .cifra {
    text-align: center;
    padding: 0.5rem 0.25rem;
    border-right: 1px solid color-mix(in oklch, var(--oro) 22%, transparent);
  }
  .cifra:last-child { border-right: none; }
  .cifra dt {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    color: var(--oro);
  }
  .cifra dt abbr { text-decoration: none; }
  .valore {
    font-size: clamp(2rem, 7vw, 3.4rem);
    line-height: 1;
    margin: 0.15rem 0 0.2rem;
    color: var(--giallo);
    font-variant-numeric: tabular-nums;
    text-shadow: 0 0 18px color-mix(in oklch, var(--giallo) 45%, transparent);
  }
  .etichetta {
    display: block;
    font-size: 0.7rem;
    color: color-mix(in oklch, var(--text) 65%, transparent);
  }
  .nota {
    margin: clamp(0.9rem, 3vw, 1.4rem) 0 0;
    font-size: 0.85rem;
    color: color-mix(in oklch, var(--text) 72%, transparent);
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .spia { animation: none; opacity: 0.8; }
  }
</style>

<script>
  import type { RigaClassifica } from "../lib/classifica";

  // Conteggio da 0 al valore, una volta sola, quando il pannello entra in vista.
  const panel = document.querySelector<HTMLElement>("[data-scoreboard]");
  if (panel) {
    const celle = [...panel.querySelectorAll<HTMLElement>("[data-valore]")];
    const movimento = !matchMedia("(prefers-reduced-motion: reduce)").matches;
    let visto = false;

    const conta = (el: HTMLElement) => {
      const target = Number(el.dataset.valore || "0");
      if (!Number.isFinite(target) || target <= 0) return;
      const durata = 900;
      const t0 = performance.now();
      const step = (t: number) => {
        const p = Math.min(1, (t - t0) / durata);
        // ease-out: parte veloce e frena
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    // I numeri scritti nella pagina ripartono da zero per il conteggio.
    if (movimento) celle.forEach((el) => el.textContent !== "-" && (el.textContent = "0"));

    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        visto = true;
        if (movimento) celle.forEach(conta);
        io.disconnect();
      },
      { threshold: 0.4 }
    );
    io.observe(panel);

    // Aggiornamento a ogni visita: i numeri di adesso, non di quando il sito e'
    // stato pubblicato. Se la richiesta fallisce resta quello che c'e'.
    fetch("/api/classifica")
      .then((r) => (r.ok ? r.json() : null))
      .then((dati: { squadre: RigaClassifica[] } | null) => {
        const noi = dati?.squadre?.find((s) => s.id === panel.dataset.noi);
        if (!noi || noi.g <= 0) return;
        panel.querySelector("[data-stato]")!.textContent = "in corso";
        panel.querySelector("[data-nota]")?.remove();
        [noi.v, noi.n, noi.p, noi.gf].forEach((valore, i) => {
          const el = celle[i];
          el.dataset.valore = String(valore);
          // Gia' in vista (o niente animazioni): numero subito. Altrimenti 0,
          // e il conteggio parte quando il pannello entra in vista.
          el.textContent = visto || !movimento ? String(valore) : "0";
        });
      })
      .catch(() => {});
  }
</script>
