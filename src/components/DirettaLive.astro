---
// Riquadro della diretta in home. Fasi (src/lib/diretta.ts):
// - prima del fischio d'inizio: conto alla rovescia;
// - per 3 ore: "In diretta ora" col video;
// - fino a 7 giorni dal fischio d'inizio: "Rivedi la partita" col video;
// - poi sparisce da solo, senza spegnerlo dal pannello.
// Il video: YouTube, Twitch (canale, video salvato, clip) o Facebook, scelto
// dal link incollato nel pannello.
//
// Perche' il passaggio fra le fasi avviene nel browser e non al momento
// della compilazione: il sito e' statico, quindi se dipendesse dalla
// compilazione resterebbe fermo all'ora in cui e' stato pubblicato. Cosi'
// basta attivare la diretta dal pannello una volta, e il riquadro cambia da
// solo all'ora giusta. In compilazione si salta solo una diretta gia' scaduta.
import diretta from "../data/diretta.json";
import EmbedConsenso from "./EmbedConsenso.astro";
import { fase, riproduttore, inizioDa, normalizzaLink } from "../lib/diretta";

const urlVideo = normalizzaLink(diretta.urlVideo ?? "");
// Ora assoluta (ISO con fuso): il browser di chiunque, anche all'estero, la
// legge giusta. Una data non valida passa com'e' e il riquadro si nasconde.
const inizio = inizioDa(diretta.inizio ?? "");
const inizioValido = !Number.isNaN(inizio.getTime());
const attiva = Boolean(diretta.attiva && diretta.inizio) && fase(inizio, new Date()) !== "scaduta";

// Twitch vuole nel riproduttore tutti i domini da cui il sito si apre.
const dominio = Astro.site?.hostname ?? "localhost";
const video = urlVideo ? riproduttore(urlVideo, [dominio, `www.${dominio}`, "localhost"]) : null;
---
{attiva && (
  <section class="diretta" data-diretta data-inizio={inizioValido ? inizio.toISOString() : diretta.inizio} aria-labelledby="diretta-title">
    <div class="inner">
      <p class="etichetta font-display" data-etichetta>
        <span class="pallino" aria-hidden="true"></span>
        <span data-etichetta-testo>Prossima diretta</span>
      </p>

      <h2 id="diretta-title" class="font-display">
        {diretta.titolo || "Diretta dal campo"}
      </h2>

      {/* Prima del fischio d'inizio */}
      <div class="attesa" data-attesa>
        <p class="conto font-display" data-conto aria-live="off">
          <span class="sr-only">Mancano </span>
        </p>
      </div>
      <p class="quando" data-quando></p>

      {/* Dal fischio d'inizio in poi (diretta, poi replica) */}
      <div class="live" data-live hidden>
        {video ? (
          <div data-video>
            <EmbedConsenso
              src={video.src}
              title={`Diretta: ${diretta.titolo || "partita"}`}
              servizio={video.servizio}
              altezza={video.altezza}
              nota={video.nota}
              apri={urlVideo}
              video
            />
          </div>
        ) : urlVideo ? (
          <p class="senza-video">
            <a href={urlVideo} target="_blank" rel="noopener noreferrer">Guarda la diretta ↗</a>
          </p>
        ) : (
          <p class="senza-video">
            La diretta è in partenza sui canali della società.
          </p>
        )}
        {video?.replicaTwitch && (
          <p class="senza-video" data-replica-twitch hidden>
            La diretta è finita.{" "}
            <a href={video.replicaTwitch} target="_blank" rel="noopener noreferrer">Rivedila su Twitch ↗</a>
          </p>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .diretta {
    background: color-mix(in oklch, var(--rosso) 12%, var(--surface));
    border-top: 2px solid var(--rosso);
    border-bottom: 2px solid var(--rosso);
    padding: clamp(2rem, 5vw, 3rem) clamp(1rem, 4vw, 2.5rem);
  }
  .inner { max-width: 900px; margin: 0 auto; text-align: center; }

  .etichetta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rosso);
  }
  .pallino {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--rosso);
  }
  /* Il pallino pulsa solo quando si e' davvero in onda: prima sarebbe una
     bugia visiva. In replica e' spento. */
  .diretta.in-onda .pallino {
    box-shadow: 0 0 10px var(--rosso);
    animation: pulsa 1.6s ease-in-out infinite;
  }
  .diretta.replica .pallino { background: color-mix(in oklch, var(--text) 45%, transparent); }
  .diretta.replica .etichetta { color: color-mix(in oklch, var(--text) 75%, transparent); }
  @keyframes pulsa {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 1; }
  }

  .diretta h2 {
    font-size: clamp(1.4rem, 3.5vw, 2.1rem);
    margin: 0 0 1.25rem;
  }
  .conto {
    font-size: clamp(2rem, 7vw, 3.4rem);
    line-height: 1;
    margin: 0;
    color: var(--giallo);
    font-variant-numeric: tabular-nums;
  }
  .quando {
    margin: 0.6rem 0 0;
    font-size: 0.9rem;
    color: color-mix(in oklch, var(--text) 78%, transparent);
  }
  .live { margin-top: 1rem; }
  .senza-video { margin: 0; }
  .senza-video[hidden], [data-video][hidden] { display: none; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .diretta.in-onda .pallino { animation: none; opacity: 1; }
  }
</style>

<script>
  import { fase, type Fase } from "../lib/diretta";

  const box = document.querySelector<HTMLElement>("[data-diretta]");
  if (box) {
    const inizio = new Date(box.dataset.inizio ?? "");
    const attesa = box.querySelector<HTMLElement>("[data-attesa]");
    const live = box.querySelector<HTMLElement>("[data-live]");
    const conto = box.querySelector<HTMLElement>("[data-conto]");
    const quando = box.querySelector<HTMLElement>("[data-quando]");
    const etichetta = box.querySelector<HTMLElement>("[data-etichetta-testo]");
    const video = box.querySelector<HTMLElement>("[data-video]");
    const replicaTwitch = box.querySelector<HTMLElement>("[data-replica-twitch]");

    if (Number.isNaN(inizio.getTime())) {
      // Data non valida inserita dal pannello: meglio nascondere tutto che
      // mostrare "NaN" a un tifoso.
      box.hidden = true;
    } else {
      const data = (opzioni: Intl.DateTimeFormatOptions) => inizio.toLocaleString("it-IT", opzioni);
      let ultima: Fase | null = null;

      const mostra = (f: Fase) => {
        if (f === ultima) return;
        ultima = f;
        box.classList.toggle("in-onda", f === "in-onda");
        box.classList.toggle("replica", f === "replica");
        // Finita la diretta senza un video da rivedere (nessun link, o un link
        // non incorporabile): niente "Rivedi la partita" a vuoto per una settimana.
        if (f === "scaduta" || (f === "replica" && !video && !replicaTwitch)) { box.hidden = true; return; }
        if (attesa) attesa.hidden = f !== "attesa";
        if (live) live.hidden = f === "attesa";
        // Canale Twitch: finita la diretta il riproduttore direbbe "offline".
        if (replicaTwitch && video) {
          video.hidden = f === "replica";
          replicaTwitch.hidden = f !== "replica";
        }
        if (etichetta) {
          etichetta.textContent = f === "attesa" ? "Prossima diretta" : f === "in-onda" ? "In diretta ora" : "Rivedi la partita";
        }
        if (quando) {
          quando.textContent =
            f === "replica"
              ? `Giocata ${data({ weekday: "long", day: "numeric", month: "long" })}`
              : `Fischio d'inizio ${data({ weekday: "long", day: "numeric", month: "long", hour: "2-digit", minute: "2-digit" })}`;
        }
      };

      const aggiorna = () => {
        const ora = new Date();
        const f = fase(inizio, ora);
        if (!f) return;
        mostra(f);
        if (f === "attesa" && conto) {
          const s = Math.floor((inizio.getTime() - ora.getTime()) / 1000);
          const g = Math.floor(s / 86400);
          const o = Math.floor((s % 86400) / 3600);
          const m = Math.floor((s % 3600) / 60);
          const sec = s % 60;
          conto.textContent =
            g > 0
              ? `${g}g ${o}h ${m}m`
              : `${String(o).padStart(2, "0")}:${String(m).padStart(2, "0")}:${String(sec).padStart(2, "0")}`;
        }
      };

      aggiorna();
      // Al secondo quando il conto mostra i secondi (ultime 24 ore prima del
      // fischio), altrimenti ogni 30 secondi: basta per cambiare fase
      // (diretta, replica, sparito) anche con la pagina aperta a lungo.
      const passo = () => (fase(inizio, new Date()) === "attesa" && inizio.getTime() - Date.now() < 86_400_000 ? 1000 : 30_000);
      const giro = () => { aggiorna(); if (ultima !== "scaduta") setTimeout(giro, passo()); };
      setTimeout(giro, passo());
    }
  }
</script>
