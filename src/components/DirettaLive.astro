---
// Riquadro della diretta in home. Fasi (src/lib/diretta.ts):
// - prima del fischio d'inizio: conto alla rovescia;
// - per 3 ore: "In diretta ora" col video;
// - fino a 7 giorni dal fischio d'inizio: "Rivedi la partita" col video;
// - poi sparisce da solo, senza spegnerlo dal pannello.
// Il video: YouTube, Twitch (canale, video salvato, clip) o Facebook, scelto
// dal link incollato nel pannello.
//
// Perche' il passaggio fra le fasi avviene nel browser e non al momento
// della compilazione: il sito e' statico, quindi se dipendesse dalla
// compilazione resterebbe fermo all'ora in cui e' stato pubblicato. Cosi'
// basta attivare la diretta dal pannello una volta, e il riquadro cambia da
// solo all'ora giusta. In compilazione si salta solo una diretta gia' scaduta.
import diretta from "../data/diretta.json";
import EmbedConsenso from "./EmbedConsenso.astro";
import { mostraRiquadro, riproduttore, inizioDa, normalizzaLink } from "../lib/diretta";

const urlVideo = normalizzaLink(diretta.urlVideo ?? "");
// Ora assoluta (ISO con fuso): il browser di chiunque, anche all'estero, la
// legge giusta. Senza ora (facoltativa) niente conto alla rovescia ne' fasi:
// il video e' subito visibile come "Guarda la partita" finche' l'interruttore
// resta acceso.
const inizio = inizioDa(diretta.inizio ?? "");
const senzaOra = Number.isNaN(inizio.getTime());
const attiva = mostraRiquadro(Boolean(diretta.attiva), inizio, urlVideo, new Date());

// Twitch vuole nel riproduttore tutti i domini da cui il sito si apre.
const dominio = Astro.site?.hostname ?? "localhost";
const domini = [dominio, `www.${dominio}`, "localhost"];
const video = urlVideo ? riproduttore(urlVideo, domini) : null;
---
{attiva && (
  <section
    class="diretta"
    data-diretta
    data-inizio={senzaOra ? undefined : inizio.toISOString()}
    data-senza-ora={senzaOra ? "" : undefined}
    data-twitch-canale={video?.canaleTwitch}
    data-twitch-src={video?.canaleTwitch ? video.src : undefined}
    data-twitch-domini={video?.canaleTwitch ? domini.join(",") : undefined}
    aria-labelledby="diretta-title"
  >
    <div class="inner">
      <p class="etichetta font-display" data-etichetta>
        <span class="pallino" aria-hidden="true"></span>
        <span data-etichetta-testo>{senzaOra ? "Guarda la partita" : "Prossima diretta"}</span>
      </p>

      <h2 id="diretta-title" class="font-display">
        {diretta.titolo || "Diretta dal campo"}
      </h2>

      {/* Prima del fischio d'inizio (solo se l'ora c'e') */}
      {!senzaOra && (
        <>
          <div class="attesa" data-attesa>
            <p class="conto font-display" data-conto aria-live="off">
              <span class="sr-only">Mancano </span>
            </p>
          </div>
          <p class="quando" data-quando></p>
        </>
      )}

      {/* Dal fischio d'inizio in poi (diretta, poi replica); senza ora: subito */}
      <div class="live" data-live hidden={!senzaOra}>
        {video ? (
          <div data-video>
            <EmbedConsenso
              src={video.src}
              title={`Diretta: ${diretta.titolo || "partita"}`}
              servizio={video.servizio}
              altezza={video.altezza}
              nota={video.nota}
              apri={urlVideo}
              video
            />
          </div>
        ) : urlVideo ? (
          <p class="senza-video">
            <a href={urlVideo} target="_blank" rel="noopener noreferrer">Guarda la diretta ↗</a>
          </p>
        ) : (
          <p class="senza-video">
            La diretta è in partenza sui canali della società.
          </p>
        )}
        {/* Canale Twitch: a diretta finita il riproduttore direbbe "offline".
            Con l'ora lo script lo sostituisce con questo collegamento; senza ora
            (nessuna fase) il collegamento sta sempre sotto il video. */}
        {video?.replicaTwitch && (
          <p class="senza-video" data-replica-twitch hidden={!senzaOra}>
            {senzaOra ? "Partita finita? " : "La diretta è finita. "}
            <a href={video.replicaTwitch} target="_blank" rel="noopener noreferrer">Rivedila su Twitch ↗</a>
          </p>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .diretta {
    background: color-mix(in oklch, var(--rosso) 12%, var(--surface));
    border-top: 2px solid var(--rosso);
    border-bottom: 2px solid var(--rosso);
    padding: clamp(2rem, 5vw, 3rem) clamp(1rem, 4vw, 2.5rem);
  }
  .inner { max-width: 900px; margin: 0 auto; text-align: center; }

  .etichetta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rosso);
  }
  .pallino {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--rosso);
  }
  /* Il pallino pulsa solo quando si e' davvero in onda: prima sarebbe una
     bugia visiva. In replica e' spento. */
  .diretta.in-onda .pallino {
    box-shadow: 0 0 10px var(--rosso);
    animation: pulsa 1.6s ease-in-out infinite;
  }
  .diretta.replica .pallino { background: color-mix(in oklch, var(--text) 45%, transparent); }
  .diretta.replica .etichetta { color: color-mix(in oklch, var(--text) 75%, transparent); }
  @keyframes pulsa {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 1; }
  }

  .diretta h2 {
    font-size: clamp(1.4rem, 3.5vw, 2.1rem);
    margin: 0 0 1.25rem;
  }
  .conto {
    font-size: clamp(2rem, 7vw, 3.4rem);
    line-height: 1;
    margin: 0;
    color: var(--giallo);
    font-variant-numeric: tabular-nums;
  }
  .quando {
    margin: 0.6rem 0 0;
    font-size: 0.9rem;
    color: color-mix(in oklch, var(--text) 78%, transparent);
  }
  .live { margin-top: 1rem; }
  .senza-video { margin: 0; }
  .senza-video[hidden], [data-video][hidden] { display: none; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .diretta.in-onda .pallino { animation: none; opacity: 1; }
  }
</style>

<script>
  import { fase, sceltaTwitch, srcVideoTwitch, type SceltaTwitch } from "../lib/diretta";

  // Stati del riquadro: "attesa" (conto alla rovescia), "in-onda", "replica",
  // "libera" (senza ora del fischio: video subito visibile). Con un canale
  // Twitch e le credenziali sul Worker, /api/twitch dice se il canale e' in
  // diretta e qual e' il video salvato: la diretta vince sull'orologio (anche
  // oltre le 3 ore) e a diretta finita il riproduttore passa da solo al video
  // salvato, dentro il sito. Senza risposta da /api/twitch resta tutto com'era.
  const box = document.querySelector<HTMLElement>("[data-diretta]");
  if (box) {
    const senzaOra = box.hasAttribute("data-senza-ora");
    const inizio = senzaOra ? null : new Date(box.dataset.inizio ?? "");
    const attesa = box.querySelector<HTMLElement>("[data-attesa]");
    const live = box.querySelector<HTMLElement>("[data-live]");
    const conto = box.querySelector<HTMLElement>("[data-conto]");
    const quando = box.querySelector<HTMLElement>("[data-quando]");
    const etichetta = box.querySelector<HTMLElement>("[data-etichetta-testo]");
    const video = box.querySelector<HTMLElement>("[data-video]");
    const replicaTwitch = box.querySelector<HTMLElement>("[data-replica-twitch]");
    const canale = box.dataset.twitchCanale;
    const srcCanale = box.dataset.twitchSrc ?? "";
    const domini = (box.dataset.twitchDomini ?? "").split(",").filter(Boolean);
    let twitch: SceltaTwitch | null = null;

    const data = (opzioni: Intl.DateTimeFormatOptions) => inizio!.toLocaleString("it-IT", opzioni);

    // Cambia il riproduttore: nel modello (se il consenso non c'e' ancora) e
    // nell'iframe gia' caricato. Solo se diverso, per non ricaricarlo.
    const usaSrc = (src: string) => {
      if (!src) return;
      const embed = video?.querySelector<HTMLElement>("[data-embed]");
      const modello = embed?.querySelector<HTMLTemplateElement>("template[data-embed-template]")?.content.querySelector("iframe");
      if (modello && modello.getAttribute("src") !== src) modello.setAttribute("src", src);
      // Iframe gia' caricato: si sostituisce invece di cambiarne src, che
      // aggiungerebbe un passo al tasto Indietro del browser.
      const caricato = embed?.querySelector<HTMLIFrameElement>(":scope > iframe");
      if (caricato && caricato.getAttribute("src") !== src) {
        const nuovo = caricato.cloneNode() as HTMLIFrameElement;
        nuovo.setAttribute("src", src);
        caricato.replaceWith(nuovo);
      }
    };

    const disegna = () => {
      const ora = new Date();
      const f = inizio ? fase(inizio, ora) : "libera";
      if (!f || f === "scaduta") { box.hidden = true; return; }

      // Una diretta sul canale conta solo vicino al fischio d'inizio (da un'ora
      // prima a 12 ore dopo): un allenamento giorni prima non prende il posto
      // del conto alla rovescia. Senza ora conta sempre.
      const vicino = !inizio || (ora.getTime() >= inizio.getTime() - 3600_000 && ora.getTime() <= inizio.getTime() + 12 * 3600_000);
      const inDiretta = twitch?.modo === "canale" && vicino;
      // Il video salvato solo a partita finita: durante la fase "in onda" resta il canale.
      const salvato = twitch && twitch.modo === "video" && (f === "replica" || f === "libera") ? twitch : null;
      const archivioVuoto = twitch?.modo === "nessuno";
      const stato = inDiretta ? "in-onda" : salvato ? "replica" : f;

      let conVideo = true;
      let conLink = false;
      if (inDiretta) usaSrc(srcCanale);
      else if (salvato) {
        usaSrc(srcVideoTwitch(salvato.id, domini));
        // Diretta interrotta e ripresa: piu' video, il collegamento li mostra tutti.
        conLink = salvato.altri && Boolean(replicaTwitch);
      } else {
        usaSrc(srcCanale);
        if (stato === "replica") {
          // Finita la diretta senza un video da rivedere (nessun link, o
          // archivio Twitch vuoto): niente "Rivedi la partita" a vuoto.
          if ((!video && !replicaTwitch) || archivioVuoto) { box.hidden = true; return; }
          conVideo = !replicaTwitch;
          conLink = Boolean(replicaTwitch);
        } else if (stato === "libera") {
          conLink = Boolean(replicaTwitch) && !archivioVuoto;
        }
      }

      box.hidden = false;
      box.classList.toggle("in-onda", stato === "in-onda");
      box.classList.toggle("replica", stato === "replica");
      if (attesa) attesa.hidden = stato !== "attesa";
      if (live) live.hidden = stato === "attesa";
      if (video) video.hidden = !conVideo;
      if (replicaTwitch) replicaTwitch.hidden = !conLink;
      if (etichetta) {
        etichetta.textContent =
          stato === "attesa" ? "Prossima diretta"
          : stato === "in-onda" ? "In diretta ora"
          : stato === "replica" ? "Rivedi la partita"
          : "Guarda la partita";
      }
      if (quando && inizio) {
        quando.textContent =
          stato === "replica"
            ? `Giocata ${data({ weekday: "long", day: "numeric", month: "long" })}`
            : `Fischio d'inizio ${data({ weekday: "long", day: "numeric", month: "long", hour: "2-digit", minute: "2-digit" })}`;
      }
      if (stato === "attesa" && conto && inizio) {
        const s = Math.max(0, Math.floor((inizio.getTime() - ora.getTime()) / 1000));
        const g = Math.floor(s / 86400);
        const o = Math.floor((s % 86400) / 3600);
        const m = Math.floor((s % 3600) / 60);
        const sec = s % 60;
        conto.textContent =
          g > 0
            ? `${g}g ${o}h ${m}m`
            : `${String(o).padStart(2, "0")}:${String(m).padStart(2, "0")}:${String(sec).padStart(2, "0")}`;
      }
    };

    disegna();

    // Orologio: al secondo quando il conto mostra i secondi (ultime 24 ore),
    // altrimenti ogni 30 secondi, per cambiare fase anche a pagina aperta.
    if (inizio && !Number.isNaN(inizio.getTime())) {
      const passo = () => (fase(inizio, new Date()) === "attesa" && inizio.getTime() - Date.now() < 86_400_000 ? 1000 : 30_000);
      const giro = () => { disegna(); if (fase(inizio, new Date()) !== "scaduta") setTimeout(giro, passo()); };
      setTimeout(giro, passo());
    }

    // Twitch: stato del canale ogni minuto (il Worker lo tiene in cache un
    // minuto), solo con la pagina in vista.
    if (canale) {
      // Durante una diretta una sola risposta "non in onda" (linea debole) non
      // basta a cambiare: servono due di fila.
      let vistoLive = false;
      let offlineDiFila = 0;
      const chiedi = async () => {
        if (document.hidden || box.hidden) return;
        try {
          const r = await fetch(`/api/twitch?canale=${encodeURIComponent(canale)}`);
          if (!r.ok) return;
          const stato = await r.json();
          if (stato.live) { vistoLive = true; offlineDiFila = 0; } else offlineDiFila++;
          twitch = !stato.live && vistoLive && offlineDiFila < 2 ? { modo: "canale" } : sceltaTwitch(stato, inizio, new Date());
          disegna();
        } catch {
          // rete assente: si riprova al prossimo giro
        }
      };
      chiedi();
      setInterval(chiedi, 60_000);
      document.addEventListener("visibilitychange", () => { if (!document.hidden) chiedi(); });
    }
  }
</script>
