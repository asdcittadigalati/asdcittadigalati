---
// Barra di scelta sui servizi di terze parti.
//
// Non e' un "banner informativo": qui la scelta ha un effetto reale. Finche'
// l'utente non accetta, gli iframe di OpenStreetMap e Tuttocampo NON vengono
// inseriti nel documento (vedi EmbedConsenso.astro), quindi nessun server
// esterno viene contattato.
//
// Non e' nemmeno un muro che copre la pagina: il contenuto resta leggibile e
// lo scorrimento non viene bloccato. "Rifiuta" e' allo stesso livello di
// "Accetta", come chiede il Garante: niente pulsante nascosto o in grigio.
---
<div class="cookie-notice" id="cookie-notice" role="region" aria-label="Scelta sui servizi di terze parti">
  <div class="cn-inner">
    <p class="cn-testo">
      Questo sito non usa cookie di profilazione e non ha statistiche di
      navigazione. Alcuni contenuti però arrivano da altri siti, la mappa, i
      dati del campionato, il video in diretta e i post dei social: caricarli
      significa collegarsi ai loro server.
      <a href="/privacy">Informativa completa</a>
    </p>
    <div class="cn-azioni">
      <button type="button" data-cn-rifiuta class="cn-secondario">Rifiuta</button>
      <button type="button" data-cn-accetta class="cn-primario">Accetta</button>
    </div>
  </div>
</div>

<style>
  .cookie-notice {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    background: var(--surface);
    color: var(--text);
    padding: 0.7rem clamp(1rem, 4vw, 2.5rem);
    border-top: 1px solid var(--oro);
    transform: translateY(120%);
    transition: transform 0.4s var(--ease-out-quart);
  }
  .cookie-notice.is-visible { transform: translateY(0); }

  .cn-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .cn-testo {
    margin: 0;
    flex: 1 1 26rem;
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .cn-testo a { color: var(--giallo); }
  .cn-azioni { display: flex; gap: 0.5rem; flex-shrink: 0; }
  .cn-azioni button {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 0.85rem;
    padding: 0.45rem 1.2rem;
    cursor: pointer;
    border: 1px solid var(--oro);
  }
  /* Stesso peso visivo per le due scelte: rifiutare deve costare quanto
     accettare, non di piu'. */
  .cn-primario { background: var(--giallo); color: var(--bg); }
  .cn-primario:hover, .cn-primario:focus-visible { background: var(--oro); }
  .cn-secondario { background: transparent; color: var(--text); }
  .cn-secondario:hover, .cn-secondario:focus-visible { background: var(--bg); color: var(--giallo); }

  @media (max-height: 700px) {
    .cookie-notice { padding: 0.5rem clamp(1rem, 4vw, 2.5rem); }
    .cn-testo { font-size: 0.78rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cookie-notice { transition: none; }
  }
</style>

<script>
  import { leggiConsenso, scriviConsenso } from "../lib/consenso";

  const barra = document.getElementById("cookie-notice");
  if (barra) {
    const nascondi = () => {
      barra.classList.remove("is-visible");
      const fine = () => (barra.hidden = true);
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) fine();
      else barra.addEventListener("transitionend", fine, { once: true });
    };

    if (leggiConsenso() !== null) {
      // Scelta gia' fatta: la barra non deve nemmeno esistere per la tastiera.
      barra.hidden = true;
    } else {
      requestAnimationFrame(() => barra.classList.add("is-visible"));
      barra.querySelector("[data-cn-accetta]")?.addEventListener("click", () => {
        scriviConsenso("accettato");
        nascondi();
      });
      barra.querySelector("[data-cn-rifiuta]")?.addEventListener("click", () => {
        scriviConsenso("rifiutato");
        nascondi();
      });
    }
  }
</script>
