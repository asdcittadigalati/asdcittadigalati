---
// Hero scroll-driven: canvas + sequenza WebP, scrub con smoothing.
// framePosition() è 1-based e frazionaria (vedi src/lib/scrub.ts); i file su
// disco sono 0-based (f-000.webp...), quindi l'indice n si mappa sul file n - 1.
// La parte decimale dissolve un frame nel successivo: senza, ogni tacca di
// rotellina salta piu' frame in un colpo e si vede lo stacco (nuvole e luci).
---
<section class="hero" id="hero">
  <div class="stage">
    <canvas id="hero-canvas" aria-hidden="true"></canvas>
    <picture>
      <source media="(max-width: 720px)" srcset="/hero-frames/mobile/f-039.webp" />
      <img id="hero-fallback" src="/hero-frames/desktop/f-069.webp" alt="Stemma ASD Città di Galati che si compone sul campo del Ducezio-Parafioriti" />
    </picture>
    <div class="overlay" id="hero-overlay">
      <h1>ASD Città<br />di Galati</h1>
      <a class="cta" href="/stagione">La stagione</a>
    </div>
  </div>
</section>
<style>
  /* 450vh danno ~3,5 schermate di corsa per la sequenza: circa 45px di scroll
     per frame invece di 17, cosi' una tacca di rotellina ne avanza due o tre
     e il movimento resta leggibile. */
  .hero { height: 450vh; }
  /* video gia' partito da solo: lo spazio per sfogliare i frame non serve piu' */
  .hero.visto { height: 100vh; }
  .stage { position: sticky; top: 0; height: 100vh; overflow: hidden; }
  canvas, #hero-fallback { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  canvas { display: none; }
  .overlay { position: absolute; inset: auto 0 12vh 0; text-align: center; opacity: 0; transform: translateY(16px); transition: opacity 0.6s var(--ease-out-quart), transform 0.6s var(--ease-out-quart); }
  .overlay.on, .overlay:focus-within { opacity: 1; transform: none; }
  /* 11vh: su portatili bassi e larghi il titolo non copre mezzo scudo. */
  .overlay h1 { font-size: clamp(3rem, min(9vw, 11vh), 7rem); text-shadow: 0 2px 24px color-mix(in oklch, var(--bg) 80%, transparent); }
  .cta { display: inline-block; margin-top: 1rem; padding: 0.8rem 2rem; background: var(--giallo); color: var(--bg); font-family: var(--font-display); text-decoration: none; font-size: 1.1rem; }
  @media (prefers-reduced-motion: reduce) { .hero { height: 100vh; } .overlay { opacity: 1; transform: none; } }
</style>
<script>
  import { framePosition, lerp } from "../lib/scrub";

  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const canvas = document.getElementById("hero-canvas") as HTMLCanvasElement;
  const fallback = document.getElementById("hero-fallback") as HTMLImageElement;
  const overlay = document.getElementById("hero-overlay")!;

  // Indice 1-based (contratto di frameIndex) -> nome file 0-based su disco.
  const frameFile = (dir: string, i: number) => `/hero-frames/${dir}/f-${String(i - 1).padStart(3, "0")}.webp`;

  setup();

  async function setup() {
    const portrait = matchMedia("(max-width: 720px)").matches;
    const dir = portrait ? "mobile" : "desktop";
    const manifest = await fetch("/hero-frames/manifest.json").then(r => r.json());
    const count = manifest[dir].count;
    fallback.src = frameFile(dir, count);

    if (reduced) {
      overlay.classList.add("on");
      return;
    }

    const frames: HTMLImageElement[] = new Array(count + 1);
    const load = (i: number) => new Promise<void>(res => {
      const img = new Image();
      img.onload = () => { frames[i] = img; res(); };
      img.onerror = () => res();
      img.src = frameFile(dir, i);
    });

    await Promise.all(Array.from({ length: 10 }, (_, k) => load(k + 1)));
    canvas.style.display = "block";
    fallback.style.display = "none";
    const resto: Promise<void>[] = [];
    for (let i = 11; i <= count; i++) resto.push(load(i)); // resto in background

    const ctx = canvas.getContext("2d")!;
    let target = 1, current = 1, raf = 0;
    // Posizione dell'avvio automatico: 1 finche' il video non parte da solo.
    let auto = 1;
    // Altezza dell'header fisso, in pixel del canvas: quella fascia e' coperta.
    let sottoTestata = 0;

    // Dove va il frame: in cover sull'area visibile SOTTO l'header, ma mai
    // cosi' grande da tagliare lo scudo, che occupa circa il 66% dell'altezza
    // del frame (dal 18% all'82%, misurato sul frame finale). Su schermi bassi
    // e larghi (portatili da 13") il frame si rimpicciolisce e lascia due
    // fasce ai lati, sfumate nel fondo della pagina da sfuma().
    function posa(img: HTMLImageElement) {
      const { width: cw, height: ch } = canvas;
      const vh = ch - sottoTestata;
      const s = Math.min(Math.max(cw / img.width, vh / img.height), (vh * 0.92) / (img.height * 0.66));
      const w = img.width * s, h = img.height * s;
      return { x: (cw - w) / 2, y: sottoTestata + (vh - h) / 2, w, h };
    }

    // Disegna un frame nella posizione data, con opacita' data.
    function paint(img: HTMLImageElement, p: ReturnType<typeof posa>, alpha: number) {
      ctx.globalAlpha = alpha;
      ctx.drawImage(img, p.x, p.y, p.w, p.h);
      ctx.globalAlpha = 1;
    }

    // Bordi laterali del frame resi trasparenti in sfumatura: sotto c'e' il
    // fondo della pagina, quindi niente stacco netto fra foto e fasce vuote.
    function sfuma(p: ReturnType<typeof posa>) {
      if (p.x <= 0) return;
      const f = p.w * 0.06;
      ctx.globalCompositeOperation = "destination-out";
      for (const [da, a] of [[p.x, p.x + f], [p.x + p.w, p.x + p.w - f]]) {
        const g = ctx.createLinearGradient(da, 0, a, 0);
        g.addColorStop(0, "rgba(0,0,0,1)");
        g.addColorStop(1, "rgba(0,0,0,0)");
        ctx.fillStyle = g;
        ctx.fillRect(Math.min(da, a), 0, f, canvas.height);
      }
      ctx.globalCompositeOperation = "source-over";
    }

    // Cerca il frame caricato piu' vicino a i, entro una finestra ragionevole:
    // durante il caricamento progressivo qualche frame puo' non essere pronto.
    function nearestLoaded(i: number): HTMLImageElement | undefined {
      for (let d = 0; d <= count; d++) {
        if (frames[i - d]) return frames[i - d];
        if (frames[i + d]) return frames[i + d];
      }
      return undefined;
    }

    function draw() {
      current = lerp(current, target, 0.18);
      // Dissolvenza fra il frame corrente e il successivo in base alla parte
      // decimale: evita lo stacco netto quando lo scroll salta piu' frame.
      const lo = Math.max(1, Math.min(count, Math.floor(current)));
      const hi = Math.min(count, lo + 1);
      const mix = Math.min(1, Math.max(0, current - lo));
      const imgLo = frames[lo] ?? nearestLoaded(lo);
      const imgHi = frames[hi] ?? imgLo;
      if (imgLo) {
        const p = posa(imgLo);
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        paint(imgLo, p, 1);
        if (imgHi && imgHi !== imgLo && mix > 0.01) paint(imgHi, p, mix);
        sfuma(p);
      }
      overlay.classList.toggle("on", target >= count - 2);
      if (Math.abs(current - target) > 0.01) raf = requestAnimationFrame(draw);
      else raf = 0;
    }

    function onScroll() {
      const range = Math.max(1, (document.getElementById("hero")!.offsetHeight) - innerHeight);
      target = Math.max(framePosition(scrollY, range, count), auto);
      if (!raf) raf = requestAnimationFrame(draw);
    }

    function resize() {
      canvas.width = innerWidth * devicePixelRatio;
      canvas.height = innerHeight * devicePixelRatio;
      sottoTestata = (document.querySelector<HTMLElement>(".site-header")?.offsetHeight ?? 0) * devicePixelRatio;
      if (!raf) raf = requestAnimationFrame(draw);
    }

    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", resize);
    resize(); onScroll();

    // Se nessuno tocca niente, poco dopo il caricamento l'hero parte da solo
    // come un video. Chi scorre, tocca o usa la tastiera prima lo guida con lo
    // scroll come sempre. A video finito, con la pagina ancora in cima, l'hero
    // si accorcia a una schermata: lo spazio per sfogliare i frame resterebbe
    // uno scroll a vuoto sullo stemma fermo.
    const hero = document.getElementById("hero")!;
    const ATTESA = 1000, DURATA = 3500;
    let toccato = scrollY > 5;
    const tocca = () => { toccato = true; };
    for (const t of ["wheel", "touchstart", "keydown", "pointerdown"]) addEventListener(t, tocca, { once: true, passive: true });
    addEventListener("scroll", () => { if (scrollY > 5) tocca(); }, { passive: true });

    const pronti = Promise.all(resto);
    setTimeout(() => pronti.then(() => {
      if (toccato) return;
      const t0 = performance.now();
      const passo = (ora: number) => {
        const k = Math.min(1, (ora - t0) / DURATA);
        auto = 1 + k * (count - 1);
        onScroll();
        if (k < 1) requestAnimationFrame(passo);
        else if (scrollY < innerHeight * 0.25) hero.classList.add("visto");
      };
      requestAnimationFrame(passo);
    }), ATTESA);
  }
</script>
