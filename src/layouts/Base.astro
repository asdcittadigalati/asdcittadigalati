---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieNotice from "../components/CookieNotice.astro";
import AppBanner from "../components/AppBanner.astro";
interface Props { title: string; description?: string }
const { title, description = "Sito ufficiale ASD Città di Galati" } = Astro.props;
// Nei risultati di Google il titolo e' la prima cosa che si legge: nome
// completo del club, e in home anche cosa e' e dove gioca.
const fullTitle = Astro.url.pathname === "/" ? `ASD Città di Galati · ${title}` : `${title} · ASD Città di Galati`;
// Indirizzi assoluti sul dominio di Astro.site (astro.config.mjs). Il
// canonical dice a Google che www e senza www sono la stessa pagina: conta
// solo quella senza www. Senza barra finale, come i link del sito: un
// canonical che punta a un redirect confonde Google.
const pageUrl = new URL(Astro.url.pathname.replace(/(.)\/$/, "$1"), Astro.site ?? Astro.url).href;
const ogImage = new URL("/img/og.jpg", Astro.site ?? Astro.url).href;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <!-- installabile come app dalla schermata Home (vedi AppBanner) -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#071027" />
    <meta name="apple-mobile-web-app-title" content="Città di Galati" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="it_IT" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a href="#main" class="skip-link">Salta al contenuto</a>
    <Header />
    <slot />
    <Footer />
    <CookieNotice />
    <AppBanner nome="Città di Galati" />
    <script>
      // Ripiego per il reveal dei titoli nei browser senza animation-timeline
      // (Firefox, Safari meno recenti): stessa resa, via IntersectionObserver.
      // Dove view() esiste ci pensa il CSS e questo script non tocca nulla.
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reduced && !CSS.supports("animation-timeline: view()")) {
        const titles = document.querySelectorAll("main h2, main [data-reveal]");
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("reveal-on");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -20% 0px" }
        );
        for (const t of titles) {
          t.classList.add("reveal-js");
          io.observe(t);
        }
      }
    </script>
  </body>
</html>
<style>
  .skip-link {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    padding: 0.75rem 1.25rem;
    background: var(--giallo);
    color: var(--bg);
    font-family: var(--font-display);
    text-decoration: none;
    transform: translateY(-110%);
    transition: transform 0.2s var(--ease-out-quart);
  }
  .skip-link:focus {
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .skip-link {
      transition: none;
    }
  }
</style>
