---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import SocialPost from "../components/SocialPost.astro";
import NextMatch from "../components/NextMatch.astro";
import SponsorStrip from "../components/SponsorStrip.astro";
import KineticRibbon from "../components/KineticRibbon.astro";
import societa from "../data/societa.json";
import DirettaLive from "../components/DirettaLive.astro";
import Formazione from "../components/Formazione.astro";
import ClassificaHome from "../components/ClassificaHome.astro";
import PlayerDialog from "../components/PlayerDialog.astro";
import { componiFormazione } from "../lib/formazione";
import datiFormazione from "../data/formazione.json";

const social = (await getCollection("social"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
// Formazione dal pannello (voce "Formazione"): sempre visibile, anche incompleta.
const formazione = componiFormazione(
  datiFormazione,
  (await getCollection("giocatori")).map((g) => g.data)
);

// Il claim si scrive dal pannello su piu' righe: ogni riga diventa un a capo.
// Ogni riga viene spezzata in parole gia' qui, in build: servono al coro
// (entrata sfalsata parola per parola) senza toccare il DOM a runtime.
const righeClaim = societa.claimHome.split(/\r?\n/).filter(Boolean);
let indiceParola = 0;
const claimParole = righeClaim.map((riga) =>
  riga.split(/\s+/).filter(Boolean).map((parola) => ({ parola, i: indiceParola++ }))
);
---
<Base title="Home">
  <main id="main" tabindex="-1">
    <Hero />

    <DirettaLive />

    {social.length > 0 && (
      <section class="social-section" aria-labelledby="social-title">
        <div class="section-inner">
          <h2 id="social-title" class="font-display">Dai social</h2>
          <div class="social-grid">
            {social.map((p) => <SocialPost link={p.data.link} date={p.data.date} />)}
          </div>
          <p class="all-news"><a href="/social">Tutti i post</a></p>
        </div>
      </section>
    )}

    <NextMatch />

    <ClassificaHome />

    {formazione &&<Formazione formazione={formazione} />}

    <!-- FOTO FITTIZIA generata: sostituire con una foto vera di pubblico al Ducezio -->
    <section class="paese" aria-labelledby="paese-claim">
      <img
        src="/img/foto/tifosi.webp"
        alt="Tifosi di spalle lungo la recinzione del campo, sotto le torri faro accese all'imbrunire"
        width="1600"
        height="894"
        loading="lazy"
      />
      <div class="paese-testo">
        <p id="paese-claim" class="font-display" data-coro>
          {claimParole.map((riga) => (
            <span class="linea">
              {riga.map(({ parola, i }) => (
                <><span class="parola" style={`--i: ${i}`}>{parola}</span>{" "}</>
              ))}
            </span>
          ))}
        </p>
      </div>
    </section>

    <KineticRibbon />

    <SponsorStrip />
    <PlayerDialog />
  </main>
</Base>
<style>
  /* Fascia a tutta larghezza: la foto porta l'atmosfera, il claim ci sta sopra
     ancorato in basso a sinistra. Nessun contenitore, nessuna card. */
  .paese {
    position: relative;
    isolation: isolate;
    overflow: hidden; /* contiene la foto ingrandita dal parallax */
  }
  .paese img {
    width: 100%;
    height: clamp(280px, 46vw, 560px);
    object-fit: cover;
    display: block;
  }

  /* Parallax + accensione: scendendo la pagina la foto scorre piano in senso
     opposto e le torri faro "si accendono" (da quasi spente a piena luce).
     Legato allo scroll con view(); dove manca resta la foto normale.
     SOLO proprieta' animation-* estese: il minificatore fonde la scorciatoia
     con animation-timeline e il browser scarta tutto (vedi atmosphere.css). */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .paese img {
        animation-name: paese-accensione;
        animation-duration: 1s;
        animation-fill-mode: both;
        animation-timing-function: linear;
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }
    }
  }
  @keyframes paese-accensione {
    from {
      transform: translateY(-5%) scale(1.12);
      filter: brightness(0.45) saturate(0.85);
    }
    45% {
      filter: brightness(1) saturate(1);
    }
    to {
      transform: translateY(5%) scale(1.12);
      filter: brightness(1.06) saturate(1);
    }
  }

  /* Coro del claim: le parole entrano una alla volta, a scatti, quando la
     fascia arriva in vista. Lo script sotto nasconde le parole SOLO quando
     gira (classe coro-pronto): senza JS il claim resta visibile da subito. */
  .linea {
    display: block;
  }
  .parola {
    display: inline-block;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-coro].coro-pronto .parola {
      opacity: 0;
      transform: translateY(0.45em);
    }
    [data-coro].coro-on .parola {
      animation-name: parola-coro;
      animation-duration: 0.32s;
      animation-fill-mode: forwards;
      animation-timing-function: var(--ease-out-quart);
      animation-delay: calc(var(--i) * 75ms);
    }
  }
  @keyframes parola-coro {
    from {
      opacity: 0;
      transform: translateY(0.45em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .paese::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in oklch, var(--bg) 88%, transparent) 5%,
      transparent 60%
    );
  }
  .paese-testo {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    padding: clamp(1.5rem, 5vw, 3rem) clamp(1rem, 4vw, 2.5rem);
    max-width: 1200px;
    margin: 0 auto;
  }
  .paese-testo p {
    margin: 0;
    text-transform: uppercase;
    line-height: 1.05;
    font-size: clamp(1.6rem, 5vw, 3.25rem);
    color: var(--text);
    text-shadow: 0 2px 20px color-mix(in oklch, var(--bg) 85%, transparent);
  }
  .social-section {
    padding: clamp(3rem, 8vw, 6rem) clamp(1rem, 4vw, 2.5rem) clamp(2rem, 6vw, 4rem);
  }
  .section-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .social-section h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 1.5rem;
  }
  .social-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem 1.5rem;
  }
  /* Tre colonne uguali: un riquadro social largo due colonne resterebbe
     comunque stretto al centro (le piattaforme fissano la larghezza). */
  @media (min-width: 720px) {
    .social-grid {
      grid-template-columns: repeat(3, 1fr);
      align-items: start;
    }
  }
  .all-news {
    margin: 1.5rem 0 0;
  }
  .all-news a {
    color: var(--oro);
    text-decoration: none;
  }
  .all-news a:hover,
  .all-news a:focus-visible {
    text-decoration: underline;
  }
</style>
<script>
  // Coro del claim: quando la fascia entra in vista, le parole partono una
  // alla volta (i ritardi stanno nel CSS, qui si accende solo la classe).
  // coro-pronto nasconde le parole SOLO a script attivo: senza JS, o con
  // reduced-motion, il claim resta semplicemente visibile.
  const claim = document.querySelector<HTMLElement>("[data-coro]");
  if (claim && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    claim.classList.add("coro-pronto");
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          claim.classList.add("coro-on");
          io.disconnect();
        }
      },
      { rootMargin: "0px 0px -25% 0px" }
    );
    io.observe(claim);
  }
</script>
