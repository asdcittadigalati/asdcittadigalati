---
import Base from "../layouts/Base.astro";
import societa from "../data/societa.json";
---
<Base title="Contatti" description="Contatti dell'ASD Città di Galati">
  <main id="main" tabindex="-1">
    <section class="intro">
      <div class="inner">
        <h1 class="font-display">Contatti</h1>
        <p class="kicker">Per tesseramenti, collaborazioni o qualsiasi altra richiesta, ecco come raggiungerci.</p>
      </div>
    </section>

    <div class="banda" aria-hidden="true">
      <img src="/img/ambiente/ingresso.webp" alt="" width="1800" height="764" loading="lazy" />
    </div>

    <section class="contatti-section">
      <div class="inner">
        <aside class="dati-societari">
          <h2 class="font-display">La società</h2>
          <p class="font-display club-name">{societa.denominazioneBreve}</p>
          {societa.indirizzo ? <p>{societa.indirizzo}</p> : <p>{societa.comune}</p>}
          <p>Campo sportivo &quot;{societa.campoNome}&quot;</p>
          <p>Codice fiscale {societa.codiceFiscale}</p>
          {societa.telefono && <p>Tel. {societa.telefono}</p>}
          {societa.email && <p><a href={`mailto:${societa.email}`}>{societa.email}</a></p>}
          {societa.pec && <p>PEC: {societa.pec}</p>}
          {!societa.telefono && !societa.email && (
            <p class="da-confermare">Recapiti telefonici e email in aggiornamento.</p>
          )}
          <p class="social-heading">Seguici</p>
          <ul class="social">
            {societa.instagram && <li><a href={societa.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></li>}
            {societa.facebook && <li><a href={societa.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></li>}
          </ul>
        </aside>
      </div>
    </section>
  </main>
</Base>
<style>
  .inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .intro {
    padding: clamp(3rem, 8vw, 5rem) clamp(1rem, 4vw, 2.5rem) clamp(1.5rem, 4vw, 2.5rem);
  }
  .intro h1 {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    margin: 0 0 0.5rem;
  }
  .kicker {
    color: var(--oro);
    max-width: 55ch;
  }
  /* Fascia d'ambiente: immagine generica e definitiva, non un segnaposto.
     In queste pagine una foto della squadra non ha senso (vedi
     public/img/LEGGIMI.md). */
  .banda {
    position: relative;
    height: clamp(140px, 22vw, 260px);
    overflow: hidden;
  }
  .banda img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .banda::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in oklch, var(--bg) 55%, transparent),
      var(--bg)
    );
  }
  .contatti-section {
    padding: clamp(1.5rem, 4vw, 2.5rem) clamp(1rem, 4vw, 2.5rem) clamp(3rem, 8vw, 6rem);
  }
  .da-confermare {
    color: var(--oro);
    font-size: 0.85rem;
    margin-top: 0.6rem;
  }
  .dati-societari {
    max-width: 640px;
    background: var(--surface);
    padding: clamp(1.5rem, 4vw, 2rem);
  }
  .dati-societari h2 {
    font-size: 1.3rem;
    margin: 0 0 1rem;
  }
  .club-name {
    font-size: 1.1rem;
    margin: 0 0 0.4rem;
  }
  .dati-societari p {
    margin: 0.2rem 0;
  }
  .dati-societari p.social-heading {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 0.9rem;
    color: var(--giallo);
    margin: 1.5rem 0 0.5rem;
  }
  .social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .social a {
    color: var(--text);
  }
  .social a:hover,
  .social a:focus-visible {
    color: var(--giallo);
  }
</style>
